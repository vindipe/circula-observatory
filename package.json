{
  "name": "circula-observatory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "preview": "wrangler dev --test-scheduled",
    "seed": "node --import tsx scripts/bootstrap.ts",
    "deploy": "npm run build && wrangler deploy",
    "test:browser": "node tests/browser.test.mjs",
    "social": "node --import tsx scripts/social.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "5.20261123.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.6.6",
    "playwright": "1.65.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "wrangler": "4.166.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0"
  }
}
