{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "circula-observatory",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-23",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/og-image.png"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "circula-observatory",
      "database_id": "58499688-0aa4-4d6d-8bda-ba4a8cfb4f18",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": [] },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
